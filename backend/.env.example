# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
# Production: number of reverse proxies in front of the app (1 for Nginx/Render/Railway/Fly), 0 locally
TRUST_PROXY=0
# Production single-origin deploy: Express serves frontend/dist (set FRONTEND_URL=BACKEND_URL=your domain)
SERVE_FRONTEND=false

# Database
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/personal_message_box

# JWT
JWT_SECRET=change-me-to-a-random-64-char-hex-string
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Optional: defaults to ${BACKEND_URL}/api/google-drive/callback
GOOGLE_REDIRECT_URI=http://localhost:3001/api/google-drive/callback

# Encryption (for Google refresh tokens)
ENCRYPTION_KEY=change-me-to-a-random-64-char-hex-string

# Upload Limits
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=100
MAX_IMAGES_PER_MESSAGE=5
MAX_VIDEOS_PER_MESSAGE=1

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX=5
PUBLIC_SUBMIT_RATE_LIMIT_MAX=10
